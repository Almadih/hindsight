  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action: Board Green with near-black ink; brightens on hover.",
      "html": "<button class=\"ds-btn-primary\">Review my games</button>",
      "css": ":host{--bg:#1c1b19;--surface:#262421;--raised:#312e2a;--line:#3d3a35;--fg:#eceae6;--muted:#a8a39b;--accent:#81b64c;font-family:Geist,system-ui,sans-serif;color:var(--fg)} .ds-btn-primary{background:var(--accent);color:#141311;font-weight:700;font-size:1rem;padding:12px 24px;border:0;border-radius:8px;cursor:pointer;transition:filter .15s} .ds-btn-primary:hover{filter:brightness(1.1)} .ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px} .ds-btn-primary:disabled{opacity:.6}"
    },
    {
      "name": "Sound Toggle",
      "kind": "button",
      "refersTo": "button-pill-toggle",
      "description": "Opt-in sound pill; off on every visit.",
      "html": "<button class=\"ds-pill\" aria-pressed=\"false\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 5 6 9H3v6h3l5 4zM16 9.5l5 5M21 9.5l-5 5\"/></svg>Sound off</button>",
      "css": ":host{--bg:#1c1b19;--surface:#262421;--raised:#312e2a;--line:#3d3a35;--fg:#eceae6;--muted:#a8a39b;--accent:#81b64c;font-family:Geist,system-ui,sans-serif;color:var(--fg)} .ds-pill{display:inline-flex;align-items:center;gap:8px;background:var(--raised);color:var(--muted);font:600 .875rem/1 Geist,system-ui,sans-serif;padding:6px 12px;border:0;border-radius:9999px;cursor:pointer} .ds-pill:hover,.ds-pill[aria-pressed=true]{color:var(--fg)} .ds-pill:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Username Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Surface field; border and outline turn Board Green on focus.",
      "html": "<input class=\"ds-input\" placeholder=\"Your Chess.com username\">",
      "css": ":host{--bg:#1c1b19;--surface:#262421;--raised:#312e2a;--line:#3d3a35;--fg:#eceae6;--muted:#a8a39b;--accent:#81b64c;font-family:Geist,system-ui,sans-serif;color:var(--fg)} .ds-input{background:var(--surface);color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:12px 16px;font-size:1rem;caret-color:var(--accent);min-width:260px} .ds-input::placeholder{color:var(--muted)} .ds-input:focus-visible{border-color:var(--accent);outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Platform Segments",
      "kind": "chip",
      "refersTo": "segment-option",
      "description": "Radio segments; selected fills Raised.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button role=\"radio\" aria-checked=\"true\">Chess.com</button><button role=\"radio\" aria-checked=\"false\">Lichess</button></div>",
      "css": ":host{--bg:#1c1b19;--surface:#262421;--raised:#312e2a;--line:#3d3a35;--fg:#eceae6;--muted:#a8a39b;--accent:#81b64c;font-family:Geist,system-ui,sans-serif;color:var(--fg)} .ds-seg{display:flex;gap:4px;font:600 .875rem Geist,system-ui,sans-serif} .ds-seg button{background:none;border:0;color:var(--muted);padding:4px 12px;border-radius:6px;cursor:pointer;font:inherit} .ds-seg button:hover{color:var(--fg)} .ds-seg button[aria-checked=true]{background:var(--raised);color:var(--fg)} .ds-seg button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
